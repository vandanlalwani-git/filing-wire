# --- never public: local databases, logs, runtime state ---
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log
*.pid
soak_*
current_soak_log.txt
_tmp_*

# --- downloaded documents and caches ---
*.pdf
bse_cache/

# --- raw corpus dumps ---
bse_filing_corpus*.json
nse_corpus.json
