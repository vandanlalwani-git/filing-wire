{
  "_meta": {
    "version": "1.0",
    "built": "2026-09-12",
    "basis": "5208 BSE filings, 2026-09-07 to 2026-09-11, 87 distinct category>subcategory pairs",
    "severity_scale": {
      "3": "CRITICAL - flare red, pulse, persist all day",
      "2": "NOTABLE - flare in direction colour, medium persist",
      "1": "ROUTINE - dim tick, short persist",
      "0": "NOISE - do not flare, available in raw feed only"
    },
    "direction": "negative | positive | neutral",
    "note": "CRITICALNEWS field from BSE is deliberately ignored - it is static per subcategory and mis-calibrated (AGM=1, auditor resignation=0)"
  },
