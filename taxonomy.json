  "headline_overrides": [
    {
      "pattern": "(?i)\\bclarification\\s+(on|regarding)\\s+price\\s+movement",
      "sev": 3,
      "dir": "neutral",
      "label": "Exchange queried price movement"
    },
    {
      "pattern": "(?i)\\bresignation\\b.{0,40}\\bauditor",
      "sev": 3,
      "dir": "negative",
      "label": "Auditor resigned"
    },
    {
      "pattern": "(?i)\\b(fire|explosion|accident|fatal|casualt)",
      "sev": 3,
      "dir": "negative",
      "label": "Incident at facility"
    },
    {
      "pattern": "(?i)\\b(fraud|misappropriat|embezzl|forensic\\s+audit)",
      "sev": 3,
      "dir": "negative",
      "label": "Fraud / forensic audit"
    },
    {
      "pattern": "(?i)\\b(raid|search\\s+and\\s+seizure|income\\s+tax\\s+department|enforcement\\s+directorate|\\bED\\b|CBI|SFIO)",
      "sev": 3,
      "dir": "negative",
      "label": "Regulatory / enforcement action"
    },
    {
      "pattern": "(?i)\\b(default|defaulted)\\b.{0,30}\\b(payment|repayment|interest|loan)",
      "sev": 3,
      "dir": "negative",
      "label": "Payment default"
    },
    {
      "pattern": "(?i)\\bpledge",
      "sev": 3,
      "dir": "neutral",
      "label": "Share pledge"
    },
    {
      "pattern": "(?i)\\b(invoc|revoc)ation\\b.{0,20}\\bpledge",
      "sev": 3,
      "dir": "negative",
      "label": "Pledge invoked"
    },
    {
      "pattern": "(?i)\\bdowngrade",
      "sev": 3,
      "dir": "negative",
      "label": "Credit rating downgraded"
    },
    {
      "pattern": "(?i)\\bupgrade",
      "sev": 2,
      "dir": "positive",
      "label": "Credit rating upgraded"
    },
    {
      "pattern": "(?i)\\b(order|contract|LOI|letter\\s+of\\s+intent|work\\s+order|purchase\\s+order)\\b.{0,40}\\b(receiv|secur|award|bag|win|won)",
      "sev": 2,
      "dir": "positive",
      "label": "Order win"
    },
    {
      "pattern": "(?i)\\bbonus\\s+issue",
      "sev": 2,
      "dir": "positive",
      "label": "Bonus issue"
    },
    {
      "pattern": "(?i)\\bstock\\s+split|\\bsub-?division\\s+of\\s+share",
      "sev": 2,
      "dir": "positive",
      "label": "Stock split"
    },
    {
      "pattern": "(?i)\\bbuy-?back",
      "sev": 2,
      "dir": "positive",
      "label": "Buyback"
    },
    {
      "pattern": "(?i)\\bdelisting",
      "sev": 3,
      "dir": "neutral",
      "label": "Delisting"
    },
    {
      "pattern": "(?i)\\bsuspension\\s+of\\s+trading|\\bsuspend",
      "sev": 3,
      "dir": "negative",
      "label": "Trading suspension"
    },
    {
      "pattern": "(?i)\\b(NCLT|NCLAT|insolvency|liquidation|winding\\s+up)",
      "sev": 3,
      "dir": "negative",
      "label": "Insolvency / tribunal matter"
    },
    {
      "pattern": "(?i)\\bqip\\b|qualified\\s+institution",
      "sev": 2,
      "dir": "neutral",
      "label": "QIP"
    },
    {
      "pattern": "(?i)\\bcommission(ing|ed)\\b|\\bcapacity\\s+expansion|\\bnew\\s+plant",
      "sev": 2,
      "dir": "positive",
      "label": "Capacity expansion"
    }
  ]
