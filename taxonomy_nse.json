{
  "_meta": {
    "version": "1.0",
    "built": "2026-09-13",
    "basis": "3210 NSE filings, 2026-09-06 to 2026-09-13, 83 distinct 'desc' values",
    "note": "Mirrors the BSE severity scale so merged feeds are comparable. NSE's vocabulary catches several events BSE has no equivalent for: Spurt in Volume, Price movement, Action(s) taken or orders passed, Fraud/Default/Arrest, Disruption of Operations.",
    "severity": {
      "3": "CRITICAL",
      "2": "NOTABLE",
      "1": "ROUTINE",
      "0": "NOISE"
    },
    "direction": "negative | positive | neutral (neutral = genuinely unknown from metadata)"
  },
