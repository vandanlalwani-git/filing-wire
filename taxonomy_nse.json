  "text_overrides": [
    {
      "pattern": "(?i)\\bdowngrad",
      "sev": 3,
      "dir": "negative",
      "label": "Credit rating downgraded"
    },
    {
      "pattern": "(?i)\\bupgrad",
      "sev": 2,
      "dir": "positive",
      "label": "Credit rating upgraded"
    },
    {
      "pattern": "(?i)\\breaffirm",
      "sev": 1,
      "dir": "neutral",
      "label": "Credit rating reaffirmed"
    },
    {
      "pattern": "(?i)\\bresignation\\b.{0,40}\\bauditor",
      "sev": 3,
      "dir": "negative",
      "label": "Auditor resigned"
    },
    {
      "pattern": "(?i)\\b(fire|explosion|fatal|casualt)",
      "sev": 3,
      "dir": "negative",
      "label": "Incident at facility"
    },
    {
      "pattern": "(?i)\\b(fraud|misappropriat|embezzl|forensic\\s+audit)",
      "sev": 3,
      "dir": "negative",
      "label": "Fraud / forensic audit"
    },
    {
      "pattern": "(?i)\\b(raid|search\\s+and\\s+seizure|enforcement\\s+directorate|SFIO)",
      "sev": 3,
      "dir": "negative",
      "label": "Enforcement action"
    },
    {
      "pattern": "(?i)\\bpledge",
      "sev": 3,
      "dir": "negative",
      "label": "Share pledge"
    },
    {
      "pattern": "(?i)\\bdelisting",
      "sev": 3,
      "dir": "neutral",
      "label": "Delisting"
    },
    {
      "pattern": "(?i)\\bbonus\\s+issue",
      "sev": 2,
      "dir": "positive",
      "label": "Bonus issue"
    },
    {
      "pattern": "(?i)\\bstock\\s+split|sub-?division\\s+of\\s+share",
      "sev": 2,
      "dir": "positive",
      "label": "Stock split"
    }
  ]
